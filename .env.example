SECRET_KEY=change-me-to-a-long-random-string
SMS_PROVIDER=console          # console (dev, prints code) | twilio
APP_NAME=DebtSMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
MAX_SENDS_PER_PHONE_PER_HOUR=3
MAX_SENDS_PER_IP_PER_HOUR=5
SESSION_COOKIE_SECURE=1

# Staff reminder tool (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DATABASE_PATH=debtsms.db
REMINDER_MIN_HOURS_BETWEEN=24
REMINDER_MAX_PER_30_DAYS=4
REMINDER_SEND_HOUR_START=8
REMINDER_SEND_HOUR_END=20
REMINDER_MAX_BATCH=50
